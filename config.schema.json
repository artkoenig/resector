{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "profiles": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "enum": [
              "llamacpp",
              "ollama",
              "lmstudio",
              "omlx"
            ]
          },
          "endpoint": {
            "description": "Server URL; default per backend (8080, 11434, 1234 on localhost)",
            "type": "string"
          },
          "model": {
            "description": "Model name as the backend knows it",
            "type": "string"
          },
          "window": {
            "description": "Context window in tokens; auto-detected when absent",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tokenizer": {
            "description": "Tokenizer path; auto-detected when absent",
            "type": "string"
          },
          "toolProtocol": {
            "default": "native",
            "type": "string",
            "enum": [
              "native",
              "text-xml"
            ]
          },
          "resultFormat": {
            "default": "native",
            "type": "string",
            "enum": [
              "native",
              "toon"
            ]
          },
          "sampling": {
            "default": {},
            "description": "Sampling parameters sent with every request, e.g. temperature",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "thinking": {
            "default": "off",
            "description": "Reasoning at session start: off, on (enable_thinking) or an effort level (reasoning_effort) the chat template accepts; `/thinking` switches it",
            "type": "string"
          },
          "compactionProfile": {
            "description": "Model Profile used for Compaction; default: this one",
            "type": "string"
          },
          "systemPrompt": {
            "description": "System prompt file, relative to this config file",
            "type": "string"
          }
        },
        "required": [
          "backend"
        ],
        "additionalProperties": false
      }
    },
    "defaultProfile": {
      "description": "Model Profile for new sessions",
      "type": "string"
    },
    "defaultPolicy": {
      "description": "Context Policy switched on for new sessions (default summary-reset, `off` for none); /policy switches it",
      "type": "string"
    },
    "permission": {
      "description": "bash command pattern → decision; the last matching rule decides: built-in, global, project config, session; none → ask",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "allow",
          "ask",
          "deny"
        ]
      }
    },
    "keybindings": {
      "description": "Action → key",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "headless": {
      "description": "Settings of `resector -p`",
      "type": "object",
      "properties": {
        "profile": {
          "description": "Model Profile; default: defaultProfile",
          "type": "string"
        },
        "policy": {
          "description": "Context Policy, `off` for none; default: defaultPolicy",
          "type": "string"
        },
        "thinking": {
          "description": "Reasoning: off, on or an effort level; default: the profile's",
          "type": "string"
        },
        "tools": {
          "description": "Exactly these tools, [] for none; default: a new session's",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "show": {
          "description": "What goes to stderr besides the closing line",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "thinking",
              "tools",
              "notes",
              "policy"
            ]
          }
        },
        "maxTurns": {
          "description": "Requests to the model at most (default 50)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "worktree": {
          "description": "Run in its own git worktree",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "bash": {
      "type": "object",
      "properties": {
        "timeout": {
          "description": "Seconds (default 120)",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
