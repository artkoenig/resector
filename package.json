{
  "name": "resector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "resector": "src/main.ts"
  },
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "^1.4.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.4.0",
    "jscpd": "^5.3.2",
    "typescript": "~5.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "crap": "bun run test:coverage && bun scripts/crap.ts",
    "mutate": "stryker run",
    "depcruise": "depcruise src",
    "dup": "jscpd",
    "gate": "bun run typecheck && bun run crap && bun run depcruise && bun run mutate && bun run dup",
    "mutate:full": "stryker run --force"
  },
  "engines": {
    "bun": ">=1.3.7"
  }
}
